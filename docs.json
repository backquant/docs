            "pages": [
              "introduction",
              "authentication",
              "quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/response-format",
              "concepts/rate-limits",
              "concepts/errors"
            ]
          }
        ]
      },
      {
