        "groups": [
          {
            "group": "GEX",
            "pages": [
              "api/gex/strike-profile",
              "api/gex/0dte-strike-profile",
              "api/gex/levels",
              "api/gex/expiry-profile",
              "api/gex/history"
            ]
          },
          {
            "group": "Market",
            "pages": [
              "api/market/index",
              "api/market/cross-asset"
            ]
          },
          {
            "group": "Perpetuals",
            "pages": [
              "api/perps/funding",
              "api/perps/open-interest",
              "api/perps/volume",
              "api/perps/long-short-ratio",
              "api/perps/cvd",
              "api/perps/coinbase-premium"
