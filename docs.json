            "pages": [
              "api/options/iv-surface",
              "api/options/term-structure",
              "api/options/skew",
              "api/options/expected-move",
              "api/options/vrp"
            ]
          },
          {
            "group": "Macro",
            "pages": [
              "api/macro/yields",
              "api/macro/inflation",
              "api/macro/credit",
              "api/macro/sentiment",
              "api/macro/btc-monetary"
            ]
          },
          {
            "group": "Equities & ETFs",
            "pages": [
              "api/equities/overview",
              "api/etf/flows",
              "api/etf/premium-aum"
            ]
          },
          {
            "group": "Liquidation",
            "pages": [
              "api/liquidation/heatmap",
              "api/liquidation/distribution"
            ]
          }
