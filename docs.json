{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "BackQuant Terminal API",
  "colors": {
    "primary": "#0F4C81",
    "light": "#E8F1FA",
    "dark": "#0A2E50"
  },
  "navbar": {
